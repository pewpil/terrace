{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "craft-anything": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/craft-anything-cli",
          "--project",
          ".",
          "mcp"
        ],
        "timeout": {
          "startup": 60000
        }
      },
      "vectorcraft": {
        "type": "local",
        "command": [
          "{env:HOME}/.local/bin/vectorcraft-cli",
          "mcp",
          "--automation-read-root",
          ".",
          "--automation-write-root",
          "."
        ],
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
