{
  "name": "terrace",
  "version": "0.1.0",
  "description": "A typing game built with OpenTUI",
  "license": "GPL-3.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && node --experimental-ffi dist/index.js",
    "start": "npm run build && node --experimental-ffi dist/index.js",
    "build": "babel src --out-dir dist --extensions .ts,.tsx",
    "build:test": "babel src --out-dir dist-test/src --extensions .ts,.tsx && babel tests --out-dir dist-test/tests --extensions .ts,.tsx",
    "test": "npm run build:test && node --experimental-ffi --no-warnings --test \"dist-test/tests/*.test.js\"",
    "build:exe": "npm run build && node scripts/build-exe.mjs",
    "skill": "node scripts/install-skills.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint src tests",
    "fmt": "prettier --write src tests",
    "fmt:check": "prettier --check src tests"
  },
  "dependencies": {
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.28.0",
    "@types/node": "^26.6.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-solid": "1.9.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-prettier": "^5.5.0",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
